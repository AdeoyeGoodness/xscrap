# Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Twitter/X accounts are added at runtime with /auth, per Telegram user, and
# stored privately under data/<uid>.*. There are no account cookies in .env.

# Optional: override where per-user data is stored (default: ./data next to .env)
# WHALE_DATA_DIR=/opt/whale/data

# Optional: route all Twitter/X traffic through a proxy.
# Needed when X/Cloudflare blocks password login from your IP.
# Example: http://user:pass@host:port
TWS_PROXY=
